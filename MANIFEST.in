include SKILL.md README.md pyproject.toml
recursive-include scripts *.py *.md
recursive-include knowledge *.json *.md
recursive-include docs *.md
recursive-include methods *.json *.md
recursive-include templates *.json *.md
recursive-include assets *.svg *.webp *.md
recursive-include benchmarks *.json
recursive-include i18n *.md
global-exclude __pycache__ *.py[cod] *.sqlite
prune .cache
prune .local
